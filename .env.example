# Скопіюйте цей файл у .env і заповніть значення. Файл .env не комітиться.

# Ключ шифрування листів, що чекають відправлення (блок у кілька рядків).
# Видає відповідальний за сховище ключів; у продакшні береться з KMS / Vault, а не з .env.
FUTURE_KEY="-----BEGIN FUTURE KEY-----
замініть-на-ключ-шифрування
-----END FUTURE KEY-----"

# Підключення до бази листів
DATABASE_URL=postgresql://letter:password@localhost:5432/letter_to_future

# Режим роботи: development | production
APP_ENV=development
